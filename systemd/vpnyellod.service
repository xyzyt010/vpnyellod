[Unit]
Description=YellowD VPN server agent (heartbeat + peer sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vpnyellod daemon
Restart=always
RestartSec=10
# Needs root: manages WireGuard interface + peers. Enabled by `vpnyellod on`.

[Install]
WantedBy=multi-user.target
